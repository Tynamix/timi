{
  "name": "timi",
  "version": "1.0.1",
  "private": true,
  "description": "Private, local menu-bar time tracking for macOS",
  "license": "MIT",
  "main": "dist/main.cjs",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:native": "npm run build && node scripts/native-smoke.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:universal": "npm run build && node scripts/package.mjs --universal",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "24.19.2",
    "electron": "44.7.2",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
