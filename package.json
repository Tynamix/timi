{
  "name": "timi",
  "version": "1.0.1",
  "private": true,
  "description": "Private, local menu-bar time tracking for macOS",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/cargo.mjs build --manifest-path src-tauri/Cargo.toml",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "test:native": "npm run build && node scripts/native-smoke.mjs",
    "package": "node scripts/package.mjs",
    "package:universal": "node scripts/package.mjs --universal",
    "check": "npm run typecheck && npm test && npm run build",
    "release": "semantic-release",
    "test:engine": "npm run build && node src/native/test-engine.mjs",
    "screenshots": "npm run build && node --import tsx scripts/screenshots.mjs",
    "check:native": "npm run build && node scripts/cargo.mjs check --manifest-path src-tauri/Cargo.toml && node scripts/cargo.mjs test --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "semantic-release": "25.0.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  }
}
